<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PraxisZeit.Setup.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.5" />
    <!-- Ed25519 license-key verification: .NET 10 has no native Ed25519
         (MLDsa is post-quantum, not Ed25519). BouncyCastle ships a
         well-tested Ed25519 verifier and PEM SubjectPublicKeyInfo parser. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.1" />
  </ItemGroup>

  <!-- mrd-report-1 (#557): Regeln der Bereinigung als eingebettete Ressourcen,
       dieselben Dateien wie im Backend (gemeinsame Regeln + Testvektoren,
       PraxisZeit-Regeln). ReportSanitizer liest sie einmal beim ersten Aufruf. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\backend\tests\data\mrd-report-1\sanitize-vectors.json" Visible="false">
      <LogicalName>mrd-sanitize-vectors.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\backend\app\core\report_rules\praxiszeit-sanitize.json" Visible="false">
      <LogicalName>praxiszeit-sanitize.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
