<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PraxisZeit.Setup.App"
             xmlns:local="using:PraxisZeit.Setup"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>

            <!-- ====== Markenpalette ====== -->
            <Color x:Key="BrandPrimary">#0E5BA8</Color>
            <Color x:Key="BrandPrimaryDark">#0A3D70</Color>
            <Color x:Key="BrandPrimaryLight">#1976D2</Color>
            <Color x:Key="BrandAccent">#13B981</Color>
            <Color x:Key="BrandAccentDark">#0E9468</Color>
            <Color x:Key="BrandWarn">#F59E0B</Color>

            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="SurfaceAltColor">#F7F9FC</Color>
            <Color x:Key="SurfaceMutedColor">#EEF2F7</Color>
            <Color x:Key="BorderColor">#E1E7EE</Color>

            <Color x:Key="TextPrimaryColor">#1A2332</Color>
            <Color x:Key="TextSecondaryColor">#5A6776</Color>
            <Color x:Key="TextMutedColor">#8A95A4</Color>
            <Color x:Key="TextInverseColor">#FFFFFF</Color>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimary}"/>
            <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDark}"/>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}"/>
            <SolidColorBrush x:Key="BrandAccentDarkBrush" Color="{StaticResource BrandAccentDark}"/>
            <SolidColorBrush x:Key="BrandWarnBrush" Color="{StaticResource BrandWarn}"/>

            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}"/>
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
            <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}"/>

            <LinearGradientBrush x:Key="HeaderBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="{StaticResource BrandPrimaryDark}" Offset="0"/>
                <GradientStop Color="{StaticResource BrandPrimary}" Offset="0.55"/>
                <GradientStop Color="{StaticResource BrandPrimaryLight}" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="{StaticResource BrandAccent}" Offset="0"/>
                <GradientStop Color="{StaticResource BrandAccentDark}" Offset="1"/>
            </LinearGradientBrush>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ====== Buttons ====== -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryDarkBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverseBrush}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandPrimaryDarkBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverseBrush}"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextInverseBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandAccentDarkBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextInverseBrush}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- ====== Cards ====== -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #0D0E2940"/>
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>

        <Style Selector="Border.pill.accent">
            <Setter Property="Background" Value="#221FAA70"/>
        </Style>

        <!-- ====== Step Indicator ====== -->
        <Style Selector="Ellipse.step">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
        </Style>
        <Style Selector="Ellipse.step.active">
            <Setter Property="Fill" Value="{StaticResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="Ellipse.step.done">
            <Setter Property="Fill" Value="{StaticResource BrandAccentBrush}"/>
        </Style>

    </Application.Styles>
</Application>
