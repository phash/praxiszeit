<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>PraxisZeit.Setup</AssemblyName>
    <RootNamespace>PraxisZeit.Setup</RootNamespace>
    <Version>1.4.0</Version>
    <Product>PraxisZeit Setup</Product>
    <Company>PraxisZeit</Company>
    <Description>PraxisZeit Setup-Wizard — Installation, Update und Reparatur</Description>
    <Copyright>Copyright (c) 2026 PraxisZeit</Copyright>
  </PropertyGroup>

  <!-- Defaults fuer `dotnet publish` -> single-file self-contained exe -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' or '$(SelfContained)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Eingebettetes Payload-ZIP (Python, PostgreSQL-Installer, Backend, Frontend,
    .bat/.ps1-Scripts, nssm). Der Build-Pipeline-Step (tools/build-release.sh)
    setzt $(PayloadZipPath) auf das gebaute praxiszeit-X.Y.Z-windows-x64.zip;
    dotnet publish bettet es dann als manifest resource mit dem stabilen
    LogicalName praxiszeit_payload.zip ein. EmbeddedPayloadExtractor liest
    es zur Laufzeit raus und extrahiert nach %TEMP%.

    Dev-Builds ohne $(PayloadZipPath) bauen ohne eingebettetes Payload —
    EmbeddedPayloadExtractor.HasEmbeddedPayload gibt false zurueck und der
    Wizard nutzt das App-Verzeichnis als Fallback (siehe MainWindowViewModel).
  -->
  <ItemGroup Condition="'$(PayloadZipPath)' != '' AND Exists('$(PayloadZipPath)')">
    <EmbeddedResource Include="$(PayloadZipPath)" Visible="false">
      <LogicalName>praxiszeit_payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- GHSA-xrw6-gwf8-vvr9: Avalonia 12.0.0 pulls Tmds.DBus.Protocol 0.90.3 (vulnerable);
         pin to 0.92.0 until Avalonia bumps its transitive. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PraxisZeit.Setup.Core\PraxisZeit.Setup.Core.csproj" />
  </ItemGroup>
</Project>
