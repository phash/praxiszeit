<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PraxisZeit.Setup.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="PraxisZeit.Setup.Views.DonePageView"
             x:DataType="vm:DonePageViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40" Spacing="24" VerticalAlignment="Center">

        <!-- Erfolgs-Checkmark (success) ODER X-Kreis (fail) -->
        <Panel HorizontalAlignment="Center" IsVisible="{Binding Success}">
            <!-- Zweistufiger, weicher Halo-Ring fuer Tiefe -->
            <Ellipse Width="124" Height="124" Fill="#1213B981"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Width="104" Height="104" Fill="#2013B981"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Hauptkreis mit Verlauf + Glow -->
            <Border Width="88" Height="88"
                    CornerRadius="44"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource AccentGradientBrush}"
                    BoxShadow="0 12 30 0 #3313B981">
                <!-- Viewbox: Haken bleibt sauber zentriert und skaliert scharf -->
                <Viewbox Width="46" Height="46"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="64" Height="64">
                        <Path Data="M 13 33 L 27 47 L 51 18"
                              Stroke="White"
                              StrokeThickness="7"
                              StrokeJoin="Round"
                              StrokeLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Panel>

        <Border Width="92" Height="92"
                CornerRadius="46"
                IsVisible="{Binding ShowErrorCard}"
                Background="#DC2626"
                HorizontalAlignment="Center"
                BoxShadow="0 8 24 0 #26DC2626">
            <Canvas Width="92" Height="92">
                <Line StartPoint="30,30" EndPoint="62,62"
                      Stroke="White" StrokeThickness="6" StrokeLineCap="Round"/>
                <Line StartPoint="62,30" EndPoint="30,62"
                      Stroke="White" StrokeThickness="6" StrokeLineCap="Round"/>
            </Canvas>
        </Border>

        <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Headline}"
                       FontSize="34"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding Summary}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="22"
                       MaxWidth="560"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- URL-Karte + Browser-Button (success) -->
        <Border IsVisible="{Binding ShowBrowserCard}"
                Classes="card"
                HorizontalAlignment="Center"
                MaxWidth="520"
                Padding="24,18">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="PraxisZeit ist erreichbar unter"
                               FontSize="11"
                               FontWeight="Medium"
                               LetterSpacing="0.6"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BrowserUrl}"
                               FontFamily="Consolas,Menlo,monospace"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- "Server startet…"-Hinweis solange der Web-Port noch nicht antwortet -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding IsWaitingForServer}">
                    <ProgressBar IsIndeterminate="True"
                                 Width="130" Height="4"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="Server startet …"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <!-- Button erst aktiv, wenn der Server auf dem Web-Port antwortet
                     (Text wechselt von "Startet…" auf "Im Browser öffnen"). -->
                <Button Classes="success"
                        Content="{Binding BrowserButtonText}"
                        MinWidth="200"
                        Height="38"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenBrowserCommand}"/>
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>

</UserControl>
