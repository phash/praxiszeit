<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PraxisZeit.Setup.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="PraxisZeit.Setup.Views.WelcomePageView"
             x:DataType="vm:WelcomePageViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32" Spacing="20">

            <!-- Greeting -->
            <StackPanel Spacing="6">
                <TextBlock Text="Willkommen"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource BrandPrimaryBrush}"
                           LetterSpacing="0.6"/>
                <TextBlock Text="Bereit zur Installation"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding ModeDescription}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           MaxWidth="660"
                           HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Status-Karte -->
            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">

                    <!-- Plattform -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <TextBlock Text="🖥"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Plattform"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   LetterSpacing="0.4"/>
                        <TextBlock Text="{Binding PlatformName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Installationspfad -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <TextBlock Text="📁"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Installationspfad"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   LetterSpacing="0.4"/>
                        <TextBlock Text="{Binding DetectedInstallPath}"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Aktuelle Version -->
                    <Border Grid.Row="2" Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <TextBlock Text="📦"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Aktuelle Version"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   LetterSpacing="0.4"/>
                        <TextBlock Text="{Binding CurrentVersion}"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Neue Version -->
                    <Border Grid.Row="3" Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="8"
                            Background="#1413B981"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <TextBlock Text="✨"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Neue Version"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   LetterSpacing="0.4"/>
                        <TextBlock Text="{Binding TargetVersion}"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandAccentDarkBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DB-Backup-Hinweis (nur im Update-Modus) -->
            <Border IsVisible="{Binding ShowBackupCallout}"
                    BorderBrush="#3313B981"
                    BorderThickness="1"
                    Background="#0A13B981"
                    CornerRadius="10"
                    Padding="16,14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Width="32" Height="32"
                            CornerRadius="16"
                            Background="{StaticResource AccentGradientBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="DB"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Datenbank wird vor dem Update gesichert"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Vor dem Datei-Update wird ein vollstaendiger pg_dump nach data\backups\ geschrieben — auch wenn das Update fehlschlaegt, bleiben Ihre Daten unversehrt."
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Footer-Hinweis -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Border Width="20" Height="20"
                        CornerRadius="10"
                        Background="{StaticResource SurfaceMutedBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="i"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Klicken Sie auf den Button unten rechts, um fortzufahren."
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
