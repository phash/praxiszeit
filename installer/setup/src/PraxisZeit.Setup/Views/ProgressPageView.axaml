<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PraxisZeit.Setup.ViewModels"
             xmlns:core="using:PraxisZeit.Setup.Core.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="PraxisZeit.Setup.Views.ProgressPageView"
             x:DataType="vm:ProgressPageViewModel">

    <UserControl.Resources>
        <vm:StepStatusToIconConverter x:Key="StatusIcon"/>
        <vm:StepStatusToBrushConverter x:Key="StatusBrush"/>
        <vm:StepStatusToTitleBrushConverter x:Key="TitleBrush"/>
    </UserControl.Resources>

    <Grid Margin="40,28,40,16" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Headline + Sub -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="{Binding Headline}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SubHeadline}"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Progress-Bar -->
        <ProgressBar Grid.Row="1"
                     Margin="0,16,0,4"
                     Height="6"
                     Minimum="0" Maximum="100"
                     Value="{Binding Percent}"
                     CornerRadius="3"
                     Foreground="{StaticResource BrandPrimaryBrush}"
                     Background="{StaticResource SurfaceMutedBrush}"/>

        <TextBlock Grid.Row="2"
                   Margin="0,2,0,12"
                   Text="{Binding Percent, StringFormat={}{0}%}"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Right"/>

        <!-- Step-Liste + Log -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="20">

            <!-- Steps -->
            <Border Grid.Column="0" Classes="card" Padding="16">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:StepItem">
                                <Grid ColumnDefinitions="28,*" Margin="0,4">
                                    <!-- Status-Icon -->
                                    <Border Grid.Column="0"
                                            Width="22" Height="22"
                                            CornerRadius="11"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusIcon}}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               Foreground="{Binding Status, Converter={StaticResource TitleBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Log -->
            <Border Grid.Column="1"
                    Background="#0D0E2940"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="10,10,0,0"
                            Padding="12,8">
                        <TextBlock Text="Protokoll"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   LetterSpacing="0.4"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  Padding="12,8"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding LogText}"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="11"
                                   LineHeight="16"
                                   TextWrapping="NoWrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
